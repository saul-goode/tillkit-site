{
  "name": "@tillkit/server",
  "version": "0.0.1",
  "description": "TillKit Hono server adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@tillkit/core": "0.0.1",
    "hono": "^4.0.0",
    "@tillkit/integration-paypal": "0.0.1",
  },
  "peerDependencies": {
    "@tillkit/integration-stripe": "0.0.1"
  },
  "peerDependenciesMeta": {
    "@tillkit/integration-stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tillkit/integration-stripe": "0.0.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
